{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Platform Service Trust Surface",
  "type": "object",
  "required": ["component", "kind", "version", "purpose", "service_boundary", "can_read", "can_write", "cannot_write", "side_effects", "requires_policy_admission", "non_goals", "projection_requirements", "application_consumption_rule", "anti_extraction_rule"],
  "properties": {
    "component": {"type": "string"},
    "kind": {"type": "string"},
    "version": {"type": "string"},
    "purpose": {"type": "string"},
    "service_boundary": {
      "type": "object",
      "required": ["owns", "does_not_own"],
      "properties": {
        "owns": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "does_not_own": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      }
    },
    "can_read": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "can_write": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "cannot_write": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "side_effects": {"type": "array", "items": {"type": "string"}},
    "requires_policy_admission": {"type": "boolean"},
    "non_goals": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "projection_requirements": {
      "type": "object",
      "required": ["applications_must_preserve"],
      "properties": {
        "applications_must_preserve": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      }
    },
    "application_consumption_rule": {"type": "string"},
    "anti_extraction_rule": {"type": "string"}
  }
}
