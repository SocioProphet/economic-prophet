      }],
      "definition": [{
        "@id": "systema:definition:wisdom-service:v0-1",
        "@type": "ConceptDefinition",
        "definitionText": "A customer engagement whose deliverable is graded, receipted knowledge that moves the client's value drivers, priced as a risk-adjusted, outcome-contingent value-transfer rather than time-and-materials.",
        "claimLevel": "operational_definition"
      }],
      "operationalDefinition": "A wisdom-service is priced only when its outcome is verified and its knowledge is assay-graded; its price is the OPX-1 decomposition.",
      "allowedUse": ["naming the estate's outcome-priced knowledge product"],
      "forbiddenUse": ["labelling time-and-materials work a wisdom-service", "a wisdom-service with no verified outcome-receipt"],
