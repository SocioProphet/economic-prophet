    {
      "@id": "systema:concept:reputation-equals-liquidity",
      "@type": "ConceptEntry",
      "conceptId": "systema:concept:reputation-equals-liquidity",
      "skos:prefLabel": "Reputation = Liquidity = Capital (Economia Mentium)",
      "skos:altLabel": ["standing as capital", "epistemic capital"],
      "sourceAnchor": [{
        "@id": "systema:source-anchor:opx1-reputation-liquidity",
        "@type": "SourceAnchor",
        "sourceRef": "SocioProphet/economic-prophet:src/open_ep_framework/outcome_pricing/pricing.py#mesh_split",
        "sourceKind": "implementation_contract",
        "extractionConfidence": "B",
        "reviewState": "candidate",
        "quoteBoundary": "operational_translation",
        "uncertaintyNote": "Economia Mentium thesis (also carried by risk_adjusted_profit.py epistemic mode); GKN standing (guild-knowledge-network) is the measured standing vector consumed as the allocation weight."
      }],
      "definition": [{
        "@id": "systema:definition:reputation-equals-liquidity:v0-1",
        "@type": "ConceptDefinition",
        "definitionText": "The doctrine that a provider's GKN standing (reputation) functions as capital/liquidity in the mesh: it weights the provider's marginal-contribution share of the engagement price, so earned standing is deployable epistemic capital.",
        "claimLevel": "operational_definition"
      }],
      "operationalDefinition": "GKN standing enters the mesh split as a non-negative weight; it modulates but never manufactures value (the split still conserves to P).",
      "allowedUse": ["weighting mesh allocation by earned standing", "expressing epistemic capital in the price"],
      "forbiddenUse": ["using reputation to break conservation (allocate more than P)", "self-reported standing without a GKN standing record"],
      "implementationSurface": [{
        "@id": "systema:surface:opx1-reputation-liquidity",
        "@type": "ImplementationSurface",
        "ownerRepo": "SocioProphet/economic-prophet",
        "surfacePath": "src/open_ep_framework/outcome_pricing/pricing.py"
      }],
      "evidenceRequirement": [{
        "@id": "systema:evidence-requirement:opx1-reputation-liquidity",
        "@type": "EvidenceRequirement",
        "evidenceRequirementText": "Standing weights are non-negative and reference a GKN standing vector; the weighted split conserves to P."
      }],
      "promotionState": "extracted_candidate",
      "revision": [{
        "@id": "systema:revision:reputation-equals-liquidity:v0-1",
        "@type": "ConceptRevision",
